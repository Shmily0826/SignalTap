{
  "manifest_version": 3,
  "name": "SignalTap",
  "version": "0.1.0",
  "description": "One tap. Just the signal. An AI information-judgment layer that analyzes the page you are already viewing.",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "sidePanel", "storage", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SignalTap - analyze this page",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
