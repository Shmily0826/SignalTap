{
  "name": "@signaltap/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prebuild-clean.mjs && vite build && vite build --config vite.config.content.ts && vite build --config vite.config.background.ts",
    "build:sidepanel": "node scripts/prebuild-clean.mjs && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/prebuild-clean.mjs && vite build && vite build --config vite.config.content.ts && vite build --config vite.config.background.ts && playwright test"
  },
  "dependencies": {
    "@signaltap/analysis": "*",
    "@signaltap/schemas": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@types/chrome": "^0.0.270",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^2.1.1"
  }
}
