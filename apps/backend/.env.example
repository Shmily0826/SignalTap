# SignalTap backend environment template
# Copy to .env and fill as needed. Never commit the real .env.

# Port for the local API server
PORT=8787

# Optional: require extension clients to send this key in x-signaltap-key.
# Leave empty to disable auth (development only).
SIGNALTAP_API_KEY=

# CORS allowed origins (comma-separated). Use "*" for local dev only.
CORS_ORIGIN=*

# Rate limit per client per minute
RATE_LIMIT_PER_MIN=20

# Provider selection: if OPENAI_API_KEY is set, the real LLM provider is used.
# Otherwise the deterministic mock provider is used (no secrets required).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Analysis call tuning
ANALYSIS_TIMEOUT_MS=60000
ANALYSIS_RETRIES=1
